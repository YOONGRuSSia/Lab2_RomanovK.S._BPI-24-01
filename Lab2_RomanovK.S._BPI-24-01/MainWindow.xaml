<Window x:Class="Lab2_RomanovK.S._BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_RomanovK.S._BPI_24_01"
        mc:Ignorable="d"
        Title="Решение уравнений"
        Height="480" Width="750"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <RadioButton Name="Radio1" Margin="5" Checked="Radio_Checked"
                             Foreground="{DynamicResource PrimaryColor}">
                    <WrapPanel>
                        <Image Name="Img1" Height="30" Margin="5"/>
                        <GroupBox Name="R1Group" Header="Параметры" Margin="5" IsEnabled="False"
                                  Foreground="{DynamicResource PrimaryColor}"
                                  BorderBrush="{DynamicResource BorderColor}">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="a" Grid.Row="0" Grid.Column="0"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R1TextA" MinWidth="70"
                                             Grid.Row="0" Grid.Column="1"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="f" Grid.Row="1" Grid.Column="0"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox Name="R1ComboF" SelectedIndex="0"
                                              Grid.Row="1" Grid.Column="1"
                                              Background="{DynamicResource White}"
                                              Foreground="{DynamicResource TextColor}"
                                              BorderBrush="{DynamicResource BorderColor}">
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                        <ComboBoxItem Content="6"/>
                                        <ComboBoxItem Content="7"/>
                                        <ComboBoxItem Content="8"/>
                                        <ComboBoxItem Content="9"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </WrapPanel>
                </RadioButton>

                <RadioButton Name="Radio2" Margin="5" Checked="Radio_Checked"
                             Foreground="{DynamicResource PrimaryColor}">
                    <WrapPanel>
                        <Image Name="Img2" Height="23" Margin="5"/>
                        <GroupBox Name="R2Group" Header="Параметры" Margin="5" IsEnabled="False"
                                  Foreground="{DynamicResource PrimaryColor}"
                                  BorderBrush="{DynamicResource BorderColor}">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="a" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R2TextA" MinWidth="70"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="b" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R2TextB" MinWidth="70"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="f" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox Name="R2ComboF" SelectedIndex="0" MinWidth="100"
                                              Background="{DynamicResource White}"
                                              Foreground="{DynamicResource TextColor}"
                                              BorderBrush="{DynamicResource BorderColor}">
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="20"/>
                                        <ComboBoxItem Content="30"/>
                                        <ComboBoxItem Content="40"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </WrapPanel>
                </RadioButton>

                <RadioButton Name="Radio3" Margin="5" Checked="Radio_Checked"
                             Foreground="{DynamicResource PrimaryColor}">
                    <WrapPanel>
                        <Image Name="Img3" Height="30" Margin="5"/>
                        <GroupBox Name="R3Group" Header="Параметры" Margin="5" IsEnabled="False"
                                  Foreground="{DynamicResource PrimaryColor}"
                                  BorderBrush="{DynamicResource BorderColor}">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="a" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R3TextA" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="b" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R3TextB" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="c" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox Name="R3ComboC" SelectedIndex="0" MinWidth="50"
                                              Background="{DynamicResource White}"
                                              Foreground="{DynamicResource TextColor}"
                                              BorderBrush="{DynamicResource BorderColor}">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="d" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox Name="R3ComboD" SelectedIndex="1" MinWidth="70"
                                              Background="{DynamicResource White}"
                                              Foreground="{DynamicResource TextColor}"
                                              BorderBrush="{DynamicResource BorderColor}">
                                        <ComboBoxItem Content="-1"/>
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </WrapPanel>
                </RadioButton>

                <RadioButton Name="Radio4" Margin="5" Checked="Radio_Checked"
                             Foreground="{DynamicResource PrimaryColor}">
                    <WrapPanel>
                        <Image Name="Img4" Height="60" Margin="5"/>
                        <GroupBox Name="R4Group" Header="Параметры" Margin="5" IsEnabled="False"
                                  Foreground="{DynamicResource PrimaryColor}"
                                  BorderBrush="{DynamicResource BorderColor}">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="c" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox Name="R4ComboC" SelectedIndex="0" MinWidth="70"
                                              Background="{DynamicResource White}"
                                              Foreground="{DynamicResource TextColor}"
                                              BorderBrush="{DynamicResource BorderColor}">
                                        <ComboBoxItem Content="0"/>
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                        <ComboBoxItem Content="4"/>
                                        <ComboBoxItem Content="5"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="d" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R4TextD" MinWidth="70"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="a" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R4TextA" MinWidth="70"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </WrapPanel>
                </RadioButton>

                <RadioButton Name="Radio5" Margin="5" Checked="Radio_Checked"
                             Foreground="{DynamicResource PrimaryColor}">
                    <WrapPanel>
                        <Image Name="Img5" Height="40" Margin="5"/>
                        <GroupBox Name="R5Group" Header="Параметры" Margin="5" IsEnabled="False"
                                  Foreground="{DynamicResource PrimaryColor}"
                                  BorderBrush="{DynamicResource BorderColor}">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="N" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R5TextN" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="K" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R5TextK" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="x" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R5TextX" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="y" Foreground="{DynamicResource PrimaryColor}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Name="R5TextY" MinWidth="50"
                                             Style="{StaticResource InputStyle}"
                                             LostFocus="TextBox_LostFocus"/>
                                </StackPanel>
                            </WrapPanel>
                        </GroupBox>
                    </WrapPanel>
                </RadioButton>

            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Name="CalcButton" Content="Считать" Width="100" Margin="10"
                Click="Calc_Click" IsEnabled="False"
                Style="{StaticResource ButtonStyle}"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>