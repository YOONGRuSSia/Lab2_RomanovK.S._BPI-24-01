<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ЦВЕТА ТЕМЫ -->
    <SolidColorBrush x:Key="WindowBg" Color="#F3E5F5"/>
    <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryColor" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="AccentColor" Color="#9C27B0"/>
    <SolidColorBrush x:Key="PressedColor" Color="#4A148C"/>
    <SolidColorBrush x:Key="BorderColor" Color="#CE93D8"/>
    <SolidColorBrush x:Key="TextColor" Color="#4A148C"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="AccentTextColor" Color="#9C27B0"/>
    <SolidColorBrush x:Key="HoverBg" Color="#F3E5F5"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#E1BEE7"/>
    <SolidColorBrush x:Key="ItemBorderColor" Color="#E1BEE7"/>
    <SolidColorBrush x:Key="White" Color="#FFFFFF"/>

    <!-- СТИЛЬ ОКНА -->
    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
    </Style>

    <!-- СТИЛЬ ЗАГОЛОВКА ОКНА -->
    <Style x:Key="WindowHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="WindowHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,12,0,12"/>
    </Style>

    <!-- СТИЛЬ ПАНЕЛЕЙ -->
    <Style x:Key="PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- СТИЛЬ ЗАГОЛОВКОВ ПОЛЕЙ -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
    </Style>

    <!-- СТИЛЬ ТЕКСТОВЫХ ПОЛЕЙ -->
    <Style x:Key="InputStyle" TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="Background" Value="{DynamicResource White}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
    </Style>

    <!-- СТИЛЬ КНОПОК (с триггерами) -->
    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PressedColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- СТИЛЬ ЭЛЕМЕНТА СПИСКА (с триггерами) -->
    <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{DynamicResource PanelBg}"
                            CornerRadius="6"
                            Margin="2"
                            BorderBrush="{DynamicResource ItemBorderColor}"
                            BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" 
                                    Property="Background" 
                                    Value="{DynamicResource HoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" 
                                    Property="Background" 
                                    Value="{DynamicResource SelectedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- СТИЛЬ ШАПКИ ТАБЛИЦЫ -->
    <Style x:Key="TableHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        <Setter Property="CornerRadius" Value="6,6,0,0"/>
    </Style>

    <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource White}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- СТИЛИ ТЕКСТА В СПИСКЕ -->
    <Style x:Key="ItemFamiliyaStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ItemDolzhnostStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ItemOkladStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- СТИЛЬ ПОДЗАГОЛОВКА ПАНЕЛИ -->
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>