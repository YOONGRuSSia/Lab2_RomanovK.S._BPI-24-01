<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Light</sys:String>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3E5F5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="BorderBrushDark" Color="#D5DAE1"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#AEB7C3"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1C2026"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9C27B0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A148C"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#E1BEE7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4A148C" Offset="0"/>
        <GradientStop Color="#6A1B9A" Offset="0.5"/>
        <GradientStop Color="#9C27B0" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AccentRadial"
                         GradientOrigin="0.3,0.3" Center="0.5,0.5"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#CE93D8" Offset="0"/>
        <GradientStop Color="#9C27B0" Offset="0.6"/>
        <GradientStop Color="#6A1B9A" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>