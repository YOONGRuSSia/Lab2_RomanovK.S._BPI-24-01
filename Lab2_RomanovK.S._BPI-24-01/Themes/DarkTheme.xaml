<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Dark</sys:String>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A0D2E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#3E2757"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#292E36"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#303640"/>
    <SolidColorBrush x:Key="BorderBrushDark" Color="#373E49"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#46505E"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DA7B5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#9C27B0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#CE93D8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6A1B9A"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#7B1FA2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B71C1C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#292E36"/>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A0D2E" Offset="0"/>
        <GradientStop Color="#4A148C" Offset="0.5"/>
        <GradientStop Color="#7B1FA2" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AccentRadial"
                         GradientOrigin="0.3,0.3" Center="0.5,0.5"
                         RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#CE93D8" Offset="0"/>
        <GradientStop Color="#7B1FA2" Offset="0.6"/>
        <GradientStop Color="#4A148C" Offset="1"/>
    </RadialGradientBrush>

</ResourceDictionary>